{
  "name": "test-matt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @test-matt/frontend dev",
    "build": "pnpm --filter @test-matt/frontend build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contract:generate": "pnpm --filter @test-matt/api-contract generate",
    "contract:check": "pnpm --filter @test-matt/api-contract check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contract:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
